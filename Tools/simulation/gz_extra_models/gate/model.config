<?xml version="1.0"?>
<model>
  <name>gate</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>dva-quad-jax</name>
    <email>nuthasith.g@gmail.com</email>
  </author>
  <description>
    Static traversal gate for the gate_traversal sim-to-sim policy.
    Inner opening 0.60 m (width) x 0.25 m (height), matching
    GATE_WIDTH / GATE_HEIGHT in dva-quad-jax envs/tasks/gate_traversal.py.
    The opening normal is the model +x axis and the opening lies in the
    model y-z plane, matching the policy's gate-local frame
    (_gate_corners_local: x=0, y=+/-0.30, z=+/-0.125). Place/orient via the
    world include pose (roll = gate roll about the normal).
  </description>
</model>
